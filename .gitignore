__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.DS_Store
Thumbs.db

# Experiment outputs are regenerated locally; only the published reference
# copies under results/figures and results/tables are tracked.
results/main/*
!results/main/.gitkeep
# Processed (publishable) result: one row per enumerated configuration.
!results/enumeration_poa_results.csv
results/logs/*
!results/logs/.gitkeep

# Never commit restricted inputs or derived artefacts
data/raw/competition_spec/
data/raw/han_et_al_2026_rasters/
poa_full_per_config*.json
delta_S2_*.json
21城市*.json

# ---------------------------------------------------------------------------
# Debug / scratch artifacts (kept locally, never published)
# Underscore-prefixed throwaway scripts and scratch directories
_*.py
_tmpdbg/

# Debug LP / MPS solver dumps
*.lp

# Local verification scratch output
results/_verify/
results/tables/_exact_src/

# Extra diagnostic figures (not the four paper figures)
results/figures/*_locked.png
results/figures/connectivity_gap_scatter.png

# Large per-configuration sensitivity raw outputs (regenerable from scripts)
results/sensitivity/*_per_config.json
